{
  "manifest_version": 3,
  "name": "yTunes",
  "version": "0.1.0",
  "description": "YouTube Music with a classic iTunes interface",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "ytunes@local",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "121.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "yTunes",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "host_permissions": ["https://music.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "exclude_matches": ["https://music.youtube.com/*?*newytm=true*"],
      "js": ["scripts/page.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "exclude_matches": ["https://music.youtube.com/*?*newytm=true*"],
      "js": [
        "scripts/host.js",
        "scripts/ytm.js",
        "layouts/shell/coverflow.js",
        "layouts/shell/script.js",
        "scripts/content.js"
      ],
      "css": ["scripts/content.css", "layouts/shell/style.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["layouts/shell/index.html"],
      "matches": ["https://music.youtube.com/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
