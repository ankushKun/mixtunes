{
  "manifest_version": 3,
  "name": "Mixtunes",
  "version": "0.1.2",
  "description": "Classic iTunes theme for Spotify, YouTube Music, SoundCloud and Apple Music",
  "homepage_url": "https://ankush.one/mixtunes/",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "mixtunes@ankush.one",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Mixtunes",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "host_permissions": [
    "https://music.youtube.com/*"
  ],
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "css": [
        "scripts/hosts/ytm/boot-hide.css"
      ],
      "js": [
        "scripts/hosts/ytm/boot.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "scripts/hosts/ytm/page-core.js",
        "scripts/hosts/ytm/page.js"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "scripts/hosts-config.js",
        "scripts/playback-core.js",
        "scripts/list-core.js",
        "scripts/dom-html.js",
        "scripts/hosts/ytm/ids.js",
        "scripts/hosts/ytm/catalog.js",
        "scripts/hosts/ytm/player.js",
        "layouts/shell/prefs.js",
        "layouts/shell/toast.js",
        "layouts/shell/dialog.js",
        "layouts/shell/marquee.js",
        "layouts/shell/coverflow.js",
        "layouts/shell/script.js",
        "scripts/content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://ankush.one/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "scripts/store-ping.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "layouts/shell/index.html",
        "layouts/shell/style.css",
        "scripts/content.css",
        "scripts/hosts/ytm/hide.css",
        "scripts/hosts/ytm/boot-hide.css"
      ],
      "matches": [
        "https://music.youtube.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://ankush.one/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
